# Runtime: read-only role only. Never prefix secrets with NEXT_PUBLIC_.
TIGER_DATABASE_URL=postgres://reef_atlas_reader:REPLACE_ME@HOST:PORT/tsdb
TIGER_POOL_MAX=5
# Optional trusted CA bundle, obtained through Tiger Cloud's documented procedure.
# TIGER_CA_CERT_PATH=/run/secrets/tiger-ca.crt
# Import scripts only: store separately in ignored .env.tiger-admin.
# TIGER_ADMIN_URL=postgres://tsdbadmin:REPLACE_ME@HOST:PORT/tsdb

# Voice agent (/api/voice/*). Server-side only.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional overrides
# GEMINI_MODEL=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Agent data source: json (bundled sample, default). "tiger" is not implemented yet.
# REEF_DATA=json
