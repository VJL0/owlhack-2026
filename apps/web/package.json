{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-cesium.mjs",
    "build": "next build && pnpm speech:build",
    "prebuild": "node scripts/copy-cesium.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "mobile:check": "node scripts/mobile-check.mjs",
    "data": "node scripts/build-data.mjs",
    "data:fetch": "node scripts/fetch-flagships.mjs",
    "data:splats": "node scripts/prepare-splats.mjs ootsl1 2 && node scripts/prepare-splats.mjs hb 2 && node scripts/analyze-soneva.mjs",
    "data:flagships": "node scripts/build-flagships.mjs",
    "db:validate": "node scripts/import-tiger.mjs --validate-only",
    "db:import": "node --env-file=.env.tiger-admin scripts/import-tiger.mjs",
    "db:atlas": "node --env-file=.env.tiger-admin scripts/import-atlas.mjs",
    "db:verify": "node --env-file=.env.tiger-admin scripts/import-tiger.mjs --verify-only && node --env-file=.env.tiger-admin scripts/import-atlas.mjs --verify-only",
    "db:export": "node --env-file=.env.tiger-admin scripts/import-tiger.mjs --verify-only --export",
    "test:db": "node --test database/*.test.mjs",
    "db:reader": "node --env-file=.env.tiger-admin scripts/provision-tiger-reader.mjs",
    "speech:dev": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/speech/server.ts",
    "speech:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-speech.mts",
    "speech:build": "node scripts/build-speech.mjs",
    "test:voice": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx --test tests/speech.test.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.69.0",
    "@elevenlabs/react": "^1.15.2",
    "@google/genai": "^2.24.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.2",
    "@sparkjsdev/spark": "2.2.0",
    "cesium": "1.145.0",
    "motion": "13.4.4",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pg-copy-streams": "^7.0.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0"
}
